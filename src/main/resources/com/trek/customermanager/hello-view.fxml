<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.trek.customermanager.HelloController">

    <top>

        <VBox spacing="8">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="CUSTOMER MANAGER"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Zambia Customer Management System"/>

        </VBox>

    </top>

    <left>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Customer Details"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="10"
                      vgap="12">

                <!-- NAME -->

                <Label text="Name:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="nameField"
                           promptText="Enter customer name"
                           prefWidth="220"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>


                <!-- PHONE -->

                <Label text="Phone:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="phoneField"
                           promptText="10-digit phone number"
                           prefWidth="220"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>


                <!-- EMAIL -->

                <Label text="Email:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="emailField"
                           promptText="Optional email"
                           prefWidth="220"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>


                <!-- PROVINCE -->

                <Label text="Province:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="provinceComboBox"
                          promptText="Select province"
                          prefWidth="220"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>


                <!-- DISTRICT -->

                <Label text="District:"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="districtComboBox"
                          promptText="Select district"
                          prefWidth="220"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="10">

                <Button text="Save Customer"
                        onAction="#handleSave"/>

                <Button text="Delete Customer"
                        onAction="#handleDelete"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Enter customer details."/>

        </VBox>

    </left>


    <center>

        <TableView fx:id="customerTable">

            <columns>

                <TableColumn fx:id="nameColumn"
                             text="Customer Name"
                             prefWidth="180"/>

                <TableColumn fx:id="phoneColumn"
                             text="Phone"
                             prefWidth="130"/>

                <TableColumn fx:id="emailColumn"
                             text="Email"
                             prefWidth="180"/>

                <TableColumn fx:id="provinceColumn"
                             text="Province"
                             prefWidth="130"/>

                <TableColumn fx:id="districtColumn"
                             text="District"
                             prefWidth="150"/>

            </columns>

        </TableView>

    </center>

</BorderPane>